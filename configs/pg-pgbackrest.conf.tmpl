# ── pgBackRest config for PG container (archive-push + archive-get) ──
# The cipher passphrase is NOT in this file: it comes from the
# PGBACKREST_REPO1_CIPHER_PASS environment variable (pgBackRest does not expand ${...}).

[__STANZA__]
pg1-path=/var/lib/postgresql/data
pg1-socket-path=/var/run/postgresql

[global]
repo1-type=s3
repo1-s3-bucket=__S3_BUCKET__
repo1-s3-region=__AWS_DEFAULT_REGION__
repo1-s3-endpoint=__S3_ENDPOINT__
repo1-s3-key-type=__S3_KEY_TYPE__
repo1-path=/pgbackrest
repo1-cipher-type=aes-256-cbc
compress-level-network=__COMPRESS_LEVEL_NETWORK__
archive-push-queue-max=256MiB
archive-timeout=__ARCHIVE_TIMEOUT__
log-level-console=info
log-path=/var/log/pgbackrest
