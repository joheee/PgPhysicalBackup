# ── pgBackRest config for backup container (scheduled backups to S3) ──

[__STANZA__]
pg1-path=/var/lib/postgresql/data
pg1-socket-path=/var/run/postgresql

[global]
repo1-type=s3
repo1-s3-bucket=__S3_BUCKET__
repo1-s3-region=__AWS_DEFAULT_REGION__
repo1-s3-endpoint=__S3_ENDPOINT__
repo1-s3-key-type=auto
repo1-path=/pgbackrest
repo1-retention-full=__RETENTION_FULL__
repo1-retention-full-type=count
repo1-retention-diff=__RETENTION_DIFF__
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=${PGBACKREST_CIPHER_PASS}
compress-type=zst
compress-level=__COMPRESS_LEVEL__
process-max=__PROCESS_MAX__
start-fast=y
log-level-console=info
log-level-file=detail
log-path=/var/log/pgbackrest
