# ─── VM Identity ──────────────────────────
# Which stanza does THIS VM's PG archive WAL to?
MY_STANZA=pg-prod

# Which stanza does THIS VM's restore container pull FROM?
REMOTE_STANZA=pg-reserve

# Initial role: "active" = backup container running, restore stopped
#              "standby" = restore container running, backup stopped
ROLE=active

# ─── PostgreSQL ───────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ─── S3 Bucket (pgBackRest repo) ──────────
S3_BUCKET=mycompany-pgbackrest-prod
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT=s3.us-east-1.amazonaws.com

# AWS credentials — pgBackRest picks these up automatically
# via repo1-s3-key-type=auto (IAM instance profile)
# If not using IAM roles, set these:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ─── pgBackRest Encryption ────────────────
# Strong passphrase for client-side AES-256-CBC encryption
# Generate with: openssl rand -base64 48
PGBACKREST_CIPHER_PASS=changeme

# ─── Optional Overrides ───────────────────
# COMPRESS_LEVEL=6
# COMPRESS_LEVEL_NETWORK=3
# PROCESS_MAX=4

# ─── Backup retention (test: keep 6) ──────
RETENTION_FULL=6
RETENTION_DIFF=6

# ─── WAL archiving interval (test: 6 minutes) ─────
ARCHIVE_TIMEOUT=360

# ─── Cron schedules (backup + restore containers) ─────
# 5-field cron: "minute hour day-of-month month day-of-week".
# Values contain spaces → keep them quoted (start.sh sources .env via `source`).
#
# Backup container (active VM): full / diff / check  (test: every 3 min)
BACKUP_FULL_CRON="*/3 * * * *"
BACKUP_DIFF_CRON="*/3 * * * *"
BACKUP_CHECK_CRON="*/3 * * * *"
#
# Restore container (standby VM): delta-restore sync  (test: every 3 min)
RESTORE_SYNC_CRON="*/3 * * * *"
