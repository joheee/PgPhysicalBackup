# Secrets — never commit
.env

# Generated config files (from templates)
configs/pg-pgbackrest.conf
configs/backup-pgbackrest.conf
configs/restore-pgbackrest.conf

# PostgreSQL data (container-owned, UID 999)
pg-data/

# Unix socket (runtime only)
pg-socket/

# pgBackRest WAL spool (runtime)
pgbackrest-spool/
