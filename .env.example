# ─── pgBackRest Stanza ──────────────────────
# Name of the backup stanza in the S3 repo. One database = one stanza.
PGBACKREST_STANZA=pg

# ─── PostgreSQL ─────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ─── S3 Bucket (pgBackRest repo) ────────────
PGBACKREST_S3_BUCKET=mycompany-pgbackrest
PGBACKREST_AWS_DEFAULT_REGION=us-east-1
PGBACKREST_S3_ENDPOINT=s3.us-east-1.amazonaws.com

# AWS credentials — repo1-s3-key-type=auto reads these from the environment.
#   EC2 (IAM instance profile): leave both unset — auto falls through to the instance role.
#   VPS (no EC2 metadata, e.g. idCloudHost): uncomment + set static IAM *user* keys.
# PGBACKREST_AWS_ACCESS_KEY_ID=
# PGBACKREST_AWS_SECRET_ACCESS_KEY=

# ─── pgBackRest Encryption ──────────────────
# Generate with: openssl rand -base64 48
PGBACKREST_CIPHER_PASS=changeme

# ─── Optional Overrides ─────────────────────
# PGBACKREST_COMPRESS_LEVEL=6
# PGBACKREST_COMPRESS_LEVEL_NETWORK=3
# PGBACKREST_PROCESS_MAX=4

# ─── Backup retention ───────────────────────
PGBACKREST_RETENTION_FULL=2
PGBACKREST_RETENTION_DIFF=4

# ─── WAL archiving interval (seconds) ───────
PGBACKREST_ARCHIVE_TIMEOUT=60

# ─── Cron schedules (backup container) ──────
# 5-field cron. Values contain spaces → keep them quoted.
PGBACKREST_BACKUP_FULL_CRON="07 2 * * 0"      # full:  Sun 02:07
PGBACKREST_BACKUP_DIFF_CRON="07 2 * * 1-6"    # diff:  Mon–Sat 02:07
PGBACKREST_BACKUP_CHECK_CRON="17 7 * * *"     # check: daily 07:17
