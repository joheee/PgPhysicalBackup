# ─── pgBackRest Stanza ──────────────────────
# Name of the backup stanza in the S3 repo. One database = one stanza.
PGBACKREST_STANZA=pg

# ─── PostgreSQL ─────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ─── S3 Bucket (pgBackRest repo) ────────────
PGBACKREST_S3_BUCKET=mycompany-pgbackrest
PGBACKREST_AWS_DEFAULT_REGION=ap-southeast-2
PGBACKREST_S3_ENDPOINT=s3.ap-southeast-2.amazonaws.com

# AWS credentials. Keep this file mode 600 (chmod 600 .env); it is git-ignored.
#   EC2 (IAM instance profile): leave both unset; start.sh selects key-type=auto.
#   Laptop / VPS (no EC2 metadata): set the scoped IAM *user* keys; start.sh selects key-type=shared.
# PGBACKREST_AWS_ACCESS_KEY_ID=
# PGBACKREST_AWS_SECRET_ACCESS_KEY=

# ─── pgBackRest Encryption ──────────────────
# Generate with: openssl rand -base64 48
# start.sh refuses to run while this is still "changeme".
PGBACKREST_CIPHER_PASS=changeme

# ─── Alerting (all optional) ────────────────
# Failed backup/check jobs POST {"text": "..."} here (Slack-compatible incoming webhook).
# ALERT_WEBHOOK_URL=
# Dead-man's switch (Healthchecks.io free tier): one check per job, pinged on success,
# <url>/fail when it fails. No ping in time = alert.
# HEALTHCHECK_URL_FULL=
# HEALTHCHECK_URL_DIFF=
# HEALTHCHECK_URL_CHECK=

# ─── pgAdmin (only with: docker compose --profile pgadmin up -d pgadmin) ───
# PGADMIN_DEFAULT_EMAIL=admin@test.com
# PGADMIN_DEFAULT_PASSWORD=

# ─── Optional Overrides ─────────────────────
# PGBACKREST_COMPRESS_LEVEL=6
# PGBACKREST_COMPRESS_LEVEL_NETWORK=3
# PGBACKREST_PROCESS_MAX=4

# ─── Backup retention ───────────────────────
PGBACKREST_RETENTION_FULL=2
PGBACKREST_RETENTION_DIFF=4

# ─── WAL archiving interval (seconds) ───────
PGBACKREST_ARCHIVE_TIMEOUT=60

# ─── Cron schedules (backup container) ──────
# 5-field cron. Values contain spaces → keep them quoted.
PGBACKREST_BACKUP_FULL_CRON="07 2 * * 0"      # full:  Sun 02:07
PGBACKREST_BACKUP_DIFF_CRON="07 2 * * 1-6"    # diff:  Mon–Sat 02:07
PGBACKREST_BACKUP_CHECK_CRON="17 7 * * *"     # check: daily 07:17
