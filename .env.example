# ─── pgBackRest Stanza ──────────────────────
# Name of the backup stanza in the S3 repo. One database = one stanza.
STANZA=pg

# ─── PostgreSQL ─────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ─── S3 Bucket (pgBackRest repo) ────────────
S3_BUCKET=mycompany-pgbackrest
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT=s3.us-east-1.amazonaws.com

# AWS credentials — picked up automatically via repo1-s3-key-type=auto (IAM instance profile)
# If not using IAM roles, set:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── pgBackRest Encryption ──────────────────
# Generate with: openssl rand -base64 48
PGBACKREST_CIPHER_PASS=changeme

# ─── Optional Overrides ─────────────────────
# COMPRESS_LEVEL=6
# COMPRESS_LEVEL_NETWORK=3
# PROCESS_MAX=4

# ─── Backup retention ───────────────────────
RETENTION_FULL=2
RETENTION_DIFF=4

# ─── WAL archiving interval (seconds) ───────
ARCHIVE_TIMEOUT=60

# ─── Cron schedules (backup container) ──────
# 5-field cron. Values contain spaces → keep them quoted.
BACKUP_FULL_CRON="07 2 * * 0"      # full:  Sun 02:07
BACKUP_DIFF_CRON="07 2 * * 1-6"    # diff:  Mon–Sat 02:07
BACKUP_CHECK_CRON="17 7 * * *"     # check: daily 07:17
